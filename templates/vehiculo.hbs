<header class="sheet-header flexrow">
  <img class="profile-img draggable" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
  
  <div class="header-details flexcol">
    <!-- input name attributes match the document data path for automatic form tracking -->
    <h1 class="charname">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Character Name"/>
    </h1>

    <div class="stats flexrow">
      <div class="stat-box">
        <label>{{localize "Ad6.Etiquetas.vehiculo"}}</label>
        <input name="system.abilities.str.value" type="number" value="{{system.abilities.str.value}}"/>
        <!-- This button maps natively to the static action handler via data-action -->
        <button type="button" data-action="rollCheck" data-stat="str">
          <i class="fas fa-dice-d20"></i> {{localize "Ad6.Etiquetas.roll"}}
        </button>
      </div>
    </div>
  </div>
</header>