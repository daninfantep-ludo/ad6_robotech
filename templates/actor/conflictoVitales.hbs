<section id="VITALES" class ="div-panel tx"> 
     
    <header class="div-panel-titulo cnt-horizontal">
        <span class="flex-0-1-auto">{{localize "Ad6.Etiquetas.vitales"}}</span>
    </header>
    <div class="cnt-horizontal">
        {{> parcialRetrato}}
        <div id="columna-izquierda-vitales">
            <div class="flx cnt-horizontal vam">
                <label class="w-80">{{localize "Ad6.Etiquetas.nombre"}}</label>
                <input type="text" name="name" value="{{actor.name}}" class="tx mrg w-200" ></input>
                <div class="cnt-horizontal vam">
                <button type="button" class="boton-ico" data-action="toggleVisibleConflicto"
                        title="{{localize "Ad6.Etiquetas.conflictoVisible"}}">
                    {{#if system.visible}}
                    <i class="fa-regular fa-eye" ></i>
                    {{else}}
                    <i class="fa-regular fa-eye-slash"></i>
                    {{/if}}
                </button>
                </div>
            </div>
            <div class="cnt-horizontal">
              <div id="HEX" class="flx fd-column mrg-r10">            
                  <div style="height:20px;" class="tx-pq">{{localize "Ad6.Etiquetas.armadura"}}</div>
                  <div class="hex-input hex-boton-normal">
                      <input type="number" name="system.armadura" value="{{system.armadura}}" class="hex-input-numero" step="1" min="0"/>
                  </div>
              </div>
              <div id="HEX" class="flx fd-column mrg-r10">            
                  <div style="height:20px;" class="tx-pq">{{localize "Ad6.Etiquetas.valor"}}</div>
                  <div class="hex-input hex-boton-normal">
                      <input type="number" name="system.valor" value="{{system.valor}}" class="hex-input-numero" step="1" min="0"/>
                  </div>
              </div>
              <div class="flx fd-column">
                <div style="height:20px;" class="tx-pq"></div>
                <div class="cnt-horizontal vam"><br/>&nbsp;
                  <i class="fas fa-solid fa-clock" style="color: var(--color-estres)"></i>
                  <label title ="{{localize "Ad6.Etiquetas.temporizado"}}"   class="check-control"><input type="checkbox" name="system.temporizado"  data-valor="{{system.temporizado}}" {{#if system.temporizado}}checked{{/if}} /></label>
                </div> 
              </div>
              <div id="HEX" class="flx fd-column mrg-r10">            
                  <div style="height:20px;" class="tx-pq">{{localize "Ad6.Etiquetas.turnos"}}</div>
                  <div class="hex-input hex-boton-estres">
                      <input type="number" name="system.tiempoRestante" value="{{system.tiempoRestante}}" class="hex-input-numero" step="1" min="0"/>
                  </div>
              </div>         
              <div id="VISIBLE">
                <div style="height:20px;" class="tx-pq"></div>
                <div class="cnt-horizontal vam"><br/>&nbsp;
                <button type="button" class="boton-ico" data-action="toggleVisibleTiempo"
                        title="{{localize "Ad6.Etiquetas.tiempoVisible"}}">
                    {{#if system.visibleTemporizador}}
                    <i class="fa-regular fa-eye" style="color: var(--color-estres)"></i>
                    {{else}}
                    <i class="fa-regular fa-eye-slash" style="color: var(--color-estres)"></i>
                    {{/if}}
                </button>
                </div>
            </div>
        </div>
    </div> 
</section>   